{
    "framework": "nextjs",
    "buildCommand": "next build",
    "devCommand": "next dev",
    "installCommand": "npm install",
    "outputDirectory": ".next",
    "crons": [
        {
            "path": "/api/cloud-cron",
            "schedule": "15 14 * * 1-5"
        },
        {
            "path": "/api/cloud-cron",
            "schedule": "35 14 * * 1-5"
        },
        {
            "path": "/api/cloud-cron",
            "schedule": "40 14 * * 1-5"
        },
        {
            "path": "/api/cloud-cron",
            "schedule": "15 15 * * 1-5"
        },
        {
            "path": "/api/cloud-cron",
            "schedule": "30 20 * * 1-5"
        },
        {
            "path": "/api/cloud-cron",
            "schedule": "55 20 * * 1-5"
        },
        {
            "path": "/api/cloud-cron",
            "schedule": "05 21 * * 1-5"
        }
    ]
}